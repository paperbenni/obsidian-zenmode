{
	"name": "zenmode",
	"version": "1.7.3",
	"description": "Zen Mode",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"format": "prettier . --write",
		"dev": "node esbuild.config.mjs",
		"build": "pnpm run format && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"author": "@paperbenni",
	"license": "GPL-2.0",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^26.6.5",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"obsidian": "1.14.4",
		"prettier": "^3.9.10",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.2"
	},
	"packageManager": "pnpm@10.20.0",
	"overrides": {
		"minimatch@<3.1.3": "^3.1.3",
		"minimatch@^4 || ^5 || ^6 || ^7 || ^8": "^8.0.5",
		"minimatch@^9": "^9.0.6",
		"picomatch@<2.3.2": "^2.3.2",
		"picomatch@^3 || ^4": "^4.0.4",
		"brace-expansion@<1.1.13": "^1.1.13",
		"brace-expansion@^2": "^2.0.3",
		"ajv@<6.14.0": "^6.14.0",
		"ajv@^7 || ^8": "^8.18.0",
		"flatted@<3.4.0": "^3.4.0",
		"fast-uri@<3.1.1": "^3.1.1",
		"yaml@<2.8.3": "^2.8.3"
	}
}
